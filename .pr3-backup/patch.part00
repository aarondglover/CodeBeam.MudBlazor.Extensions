From ed0af66d88524998bb685dc587ec990dbfbccb44 Mon Sep 17 00:00:00 2001
From: aarondglover <8821892+aarondglover@users.noreply.github.com>
Date: Sat, 26 Sep 2026 17:47:26 +0000
Subject: [PATCH] Refactor select state ownership and refresh hosted lists

---
 .../ListExtended/MudListExtended.razor.cs     |  18 +-
 .../SelectExtended/IMudSelectExtended.cs      |   4 -
 .../MudSelectExtended.PresentationState.cs    |  98 ++++++++++
 .../MudSelectExtended.SelectionText.cs        |  18 ++
 .../MudSelectExtended.ShadowItems.cs          |  24 ---
 ...SelectExtended.VirtualizedSelectionText.cs |  19 --
 .../SelectExtended/MudSelectExtended.razor    |  49 ++---
 .../SelectExtended/MudSelectExtended.razor.cs | 171 ++++++++----------
 .../MudSelectItemExtended.razor.cs            |  86 ++++-----
 .../MudSelectItemGroupExtended.razor          |  32 ++--
 .../SelectItemCollectionRefreshTest.razor     |  18 ++
 .../SelectExtended/SelectTextValueTest.razor  |   2 +
 ...electExtendedItemCollectionRefreshTests.cs |  27 +++
 .../SelectExtendedPresentationStateTests.cs   |  49 +++++
 .../Components/SelectExtendedTests.cs         |   8 +-
 .../SelectExtendedVirtualizationScaleTests.cs |  17 +-
 ...endedVirtualizationSingleSelectionTests.cs |  10 +-
 ...SelectExtendedVirtualizationStrictTests.cs |  11 +-
 .../SelectExtendedVirtualizationTests.cs      |  28 ++-
 19 files changed, 403 insertions(+), 286 deletions(-)
 create mode 100644 src/CodeBeam.MudBlazor.Extensions/Components/SelectExtended/MudSelectExtended.PresentationState.cs
 create mode 100644 src/CodeBeam.MudBlazor.Extensions/Components/SelectExtended/MudSelectExtended.SelectionText.cs
 delete mode 100644 src/CodeBeam.MudBlazor.Extensions/Components/SelectExtended/MudSelectExtended.ShadowItems.cs
 delete mode 100644 src/CodeBeam.MudBlazor.Extensions/Components/SelectExtended/MudSelectExtended.VirtualizedSelectionText.cs
 create mode 100644 tests/CodeBeam.MudBlazor.Extensions.UnitTests.Viewer/TestComponents/SelectExtended/SelectItemCollectionRefreshTest.razor
 create mode 100644 tests/CodeBeam.MudBlazor.Extensions.UnitTests/Components/SelectExtendedItemCollectionRefreshTests.cs
