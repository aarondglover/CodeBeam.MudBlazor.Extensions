@namespace MudExtensions.Docs.Examples

<MudGrid>
    <MudItem xs="12" sm="8">
        <MudStack Spacing="3">
            <MudText Typo="Typo.body2">
                Browse 1,000 options without rendering the entire list at once.
                The preselected items are near the start and end of the list.
            </MudText>

            <MudSelectExtended T="string"
                               Label="Virtualized select (1,000 items)"
                               ItemCollection="_items"
                               @bind-SelectedValues="_selectedValues"
                               Virtualize="true"
                               MultiSelection="_multiselection"
                               Clearable="_clearable" />

            <MudText Typo="Typo.caption">
                Selected: @(string.Join(", ", _selectedValues ?? []))
            </MudText>
        </MudStack>
    </MudItem>

    <MudItem xs="12" sm="4">
        <MudStack Spacing="2">
            <MudSwitchM3 @bind-Value="_multiselection" Color="Color.Secondary" Label="Multiselection" />
            <MudSwitchM3 @bind-Value="_clearable" Color="Color.Secondary" Label="Clearable" />
        </MudStack>
    </MudItem>
</MudGrid>

@code {
    private readonly string[] _items = Enumerable.Range(1, 1_000)
        .Select(index => $"Item {index:0000}")
        .ToArray();

    private IEnumerable<string?> _selectedValues = ["Item 0005", "Item 0950"];
    private bool _multiselection = true;
    private bool _clearable = false;
}
